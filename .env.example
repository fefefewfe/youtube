# Copia este archivo como .env y rellena lo que necesites. Todo es opcional.

# IA para generar preguntas y metadatos (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Voces premium de ElevenLabs (opcional; por defecto se usan las voces neuronales gratuitas de Microsoft)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# URL pública de la app (debe coincidir con el "URI de redirección" de Google para subir a YouTube)
PUBLIC_BASE_URL=http://localhost:8000
